<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer are disabled: the database holds recipients and
     private attachment copies. Use the in-app, credential-free backup instead. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
