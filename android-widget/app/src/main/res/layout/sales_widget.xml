<?xml version="1.0" encoding="utf-8"?>
<!-- See inventory_widget.xml's header comment for why RemoteViews rows
     are written out individually instead of using <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/salesWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sales"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#93C5FD" />

        <ImageButton
            android:id="@+id/salesWidgetRefreshBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/salesWidgetUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#A5B4FC"
        android:layout_marginBottom="6dp" />

    <!-- Row 1: Cash -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/salesWidgetRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cash" />
        <TextView
            android:id="@+id/salesWidgetRow1Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

    <!-- Row 2: Banks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/salesWidgetRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Banks" />
        <TextView
            android:id="@+id/salesWidgetRow2Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

    <!-- Row 3: Credit Clients -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/salesWidgetRow3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Credit Clients" />
        <TextView
            android:id="@+id/salesWidgetRow3Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

    <!-- Row 4: Customers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/salesWidgetRow4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Customers" />
        <TextView
            android:id="@+id/salesWidgetRow4Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

</LinearLayout>
