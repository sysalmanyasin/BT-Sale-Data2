<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews only supports a limited set of view types — no custom
  views, and no <include> of a repeated template either: every instance
  of an included layout keeps the SAME internal ids, so
  setTextViewText(id, ...) couldn't tell four included rows apart.
  Each row is written out directly below instead, with its own unique
  ids. Stick to LinearLayout/RelativeLayout/FrameLayout +
  TextView/ImageView/Button/ImageButton/ListView/GridView/StackView/
  ViewFlipper — that's the full set RemoteViews can render.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Low Stock"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#E0E7FF" />

        <ImageButton
            android:id="@+id/widgetRefreshBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#A5B4FC"
        android:layout_marginBottom="6dp" />

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/widgetRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widgetRow1Qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FBBF24" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/widgetRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widgetRow2Qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FBBF24" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/widgetRow3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widgetRow3Qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FBBF24" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/widgetRow4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widgetRow4Qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FBBF24" />
    </LinearLayout>

</LinearLayout>
