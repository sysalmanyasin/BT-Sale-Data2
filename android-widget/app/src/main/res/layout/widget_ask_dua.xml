<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BT  /  AI"
            android:textColor="#FFB99AFF"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READ ONLY"
            android:textColor="#FF9DABCA"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ask Dua"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/dua_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_row_dark"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:id="@+id/dua_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Your business, in plain language."
            android:textColor="#FFB99AFF"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/dua_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="8"
            android:text="Tap a suggestion or ask your own question."
            android:textColor="#FFE5EBFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dua_chip_sales"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_violet"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Today’s sales"
            android:textColor="#FFD8C8FF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/dua_chip_expenses"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_violet"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Month expenses"
            android:textColor="#FFD8C8FF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/dua_chip_credit"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_violet"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Total credit"
            android:textColor="#FFD8C8FF"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/ask_dua_open"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_violet"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="✦  Ask a question"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
