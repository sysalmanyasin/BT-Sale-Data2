<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BT  /  AI"
            android:textColor="#FFB99AFF"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READ ONLY"
            android:textColor="#FF9DABCA"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ask Dua"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="Your business, in plain language."
        android:textColor="#FFB3C1DE"
        android:textSize="11sp" />

    <Button
        android:id="@+id/ask_dua_open"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_widget_violet"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="✦  Ask a question"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
