<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/closingWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Closing"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#5EEAD4" />

        <ImageButton
            android:id="@+id/closingWidgetRefreshBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/closingWidgetUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#99F6E4"
        android:layout_marginBottom="6dp" />

    <!-- Row 1: Carried CC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/closingWidgetRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Carried CC" />
        <TextView
            android:id="@+id/closingWidgetRow1Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#5EEAD4" />
    </LinearLayout>

    <!-- Row 2: Deposits -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/closingWidgetRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Deposits" />
        <TextView
            android:id="@+id/closingWidgetRow2Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#5EEAD4" />
    </LinearLayout>

    <!-- Row 3: Book Bills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/closingWidgetRow3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Book Bills" />
        <TextView
            android:id="@+id/closingWidgetRow3Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#5EEAD4" />
    </LinearLayout>

    <!-- Row 4: Manual Returns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/closingWidgetRow4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#E5E7EB"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Manual Returns" />
        <TextView
            android:id="@+id/closingWidgetRow4Val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#5EEAD4" />
    </LinearLayout>

</LinearLayout>
