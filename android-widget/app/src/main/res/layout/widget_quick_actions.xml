<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <LinearLayout
        android:id="@+id/qa_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL CREDIT"
                android:textColor="#FF58DFFF"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/qa_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₨—"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/qa_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Tap to refresh"
            android:textColor="#FF9DABCA"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/quick_add_action"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_teal"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="＋ Jazz"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/add_credit_action"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_teal"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="＋ Credit"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/add_expense_action"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_teal"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="＋ Expense"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/add_section_action"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_teal"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="＋ Section"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="LAST 3 ENTRIES FROM HERE"
        android:textColor="#FF778BB4"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/qa_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_row_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/qa_row1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/qa_row1_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9DABCA"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/qa_row1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF54E3C2"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/qa_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_row_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/qa_row2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/qa_row2_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9DABCA"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/qa_row2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF54E3C2"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/qa_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_row_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/qa_row3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/qa_row3_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9DABCA"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/qa_row3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF54E3C2"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/qa_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Nothing added from this widget yet."
        android:textColor="#FF9DABCA"
        android:textSize="11sp" />
</LinearLayout>
