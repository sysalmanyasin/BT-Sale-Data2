<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="#FFFFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚡ Quick Add" android:textStyle="bold" android:textSize="14sp"
        android:paddingBottom="4dp" />
    <Button android:id="@+id/quick_add_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Jazz Cash" android:minHeight="36dp" />
    <Button android:id="@+id/add_credit_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Add Credit" android:minHeight="36dp" />
    <Button android:id="@+id/add_expense_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Add Expense" android:minHeight="36dp" />
</LinearLayout>
