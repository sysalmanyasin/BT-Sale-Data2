{
  "name": "bt-sales-intelligence-centre",
  "version": "1.0.0",
  "private": true,
  "description": "Bahria Town Sales Intelligence Centre \u2014 pharmacy PWA (daily sales, manager suite, notes/sheets, closing/audit/inventory bridges).",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:verbose": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "eval:live": "node scripts/agent-live-eval.mjs",
    "eval": "node --test \"tests/eval/*.test.js\"",
    "index:repo": "node scripts/build-repo-index.mjs",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "readme:sync": "node scripts/readme-facts.mjs --write",
    "readme:check": "node scripts/readme-facts.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix-report": "eslint . --format stylish",
    "bundle:check": "node scripts/bundle-check.mjs",
    "test:coverage": "c8 --check-coverage --lines 68 --branches 72 --functions 65 --reporter=text-summary --include=\"js/**\" node --test \"tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sysalmanyasin/BT-Sale-Data2.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3"
  }
}
