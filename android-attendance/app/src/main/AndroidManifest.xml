<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground location: must be granted before background location
         can even be requested (Android 10+ requires the two-step prompt
         this app's onboarding flow in MainActivity follows). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lets the geofence fire while the app is closed. Second, separate
         prompt — see MainActivity's onboarding flow. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required to show the foreground service's persistent notification
         on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR fallback scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Re-register the geofence after a reboot (Android forgets them
         otherwise) — no prompt, manifest-only. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Write attendance events to Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the foreground service's geofence-monitoring process from
         being Doze/App-Standby-killed. Declaring the permission is only
         half the story — MainActivity also sends the user to the
         system settings screen that grants it; see the manufacturer-
         specific note there for why that dialog alone isn't always
         enough on MIUI/ColorOS/Vivo/One UI. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- ManagerNotifyService's poll loop — network only, no location. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ZXing's embedded scanner activity — no entry needed here,
             the library's own manifest merges CaptureActivity in. -->

        <receiver
            android:name=".GeofenceBroadcastReceiver"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AttendanceForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Manager-mode: polls for new check-ins and posts a local
             notification per one. No location involved, so a separate
             foregroundServiceType from the staff-mode service above. -->
        <service
            android:name=".ManagerNotifyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
